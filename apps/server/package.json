{
  "name": "@rs/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "cross-env NODE_ENV=development nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:prepare": "prisma migrate deploy && prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests=false",
    "test:resume:http": "node scripts/resume-http.mjs",
    "docs:resume": "node scripts/resume-openapi.mjs",
    "test:logging:http": "node scripts/logging-http.mjs",
    "test:logging": "bash scripts/test-logging-isolated.sh",
    "test:audit:db": "vitest run --config vitest.integration.config.mts",
    "test:resume:pdf": "node scripts/resume-pdf-check.mjs",
    "test:resume:pdf:http": "node scripts/resume-pdf-http.mjs",
    "test:resume:pdf:config": "node scripts/pdf-config-layout-check.mjs",
    "test:resume:pdf:config:isolated": "bash scripts/test-pdf-config-isolated.sh"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@rs/common": "workspace:*",
    "@rs/ui": "workspace:*",
    "cross-env": "^10.1.0",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "playwright": "^1.64.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "dotenv": "^18.0.6",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
