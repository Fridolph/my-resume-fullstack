// Prisma schema —— 数据库结构的**唯一真源**。
//
// ## 它在"单一真源链"里的位置
//
// 选 Prisma 的关键理由不是"功能多"，而是能把三份容易漂移的东西收敛成一条链：
//
//     schema.prisma  ──generate──▶  Prisma Client 类型（数据库访问）
//           │
//           └──（配 zod 生成器后）──▶  Zod schema ──▶ 前端表单校验 + TS 类型
//
// 反过来（Prisma 一份、Zod 一份、手写 TS 类型一份），就是参考项目那种"多份并存"的老路。
// ⚠️ 生成 Zod 那一步（`zod-prisma-types` 等）**尚未接入** —— 等真正有表、有接口要用时再加，
//    现在接只会多一个需要维护的生成器。
//
// ## 为什么是 PostgreSQL（而不是参考项目的 MongoDB）
//
// 简历这类数据的形状是关系型的：用户 → 简历 → 版本 → 权限，需要外键、唯一约束、事务。
// 文档库能存，但约束要自己在代码里补，等于把数据库该保证的事搬到应用层。
//
// ## 命名约定
//
// - 模型 PascalCase、字段 camelCase（Prisma 默认），**表名/列名用 snake_case**（`@@map` / `@map`）
//   —— 数据库侧保持 SQL 惯例，代码侧保持 TS 惯例，两边都不别扭；
// - 时间戳统一 `createdAt` / `updatedAt`。

generator client {
  // Prisma 7：generator 名从 `prisma-client-js` 改为 `prisma-client`，且 `output` **必填**
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // 本仓 API 编译为 CommonJS（tsconfig 的 module = commonjs）；Prisma 7 默认输出 ESM，
  // 不声明就会在 require 时报错。将来若整个后端迁到 ESM，这行可以去掉。
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // ⚠️ Prisma 7 起 **不再** 在 schema 里写 url：
  // 连接串属于「CLI 用」（migrate/studio）→ 放 `prisma.config.ts`；
  // 「运行时」则由 PrismaClient 的 driver adapter 负责（见下方注释）。
}

// ── Prisma 7 的两处行为变化（都会咬人，先记在这里）──────────────────────
//
// 1. **运行时必须传 driver adapter**：v7 移除了 Rust 查询引擎，client 变成纯 TS 实现，
//    直连 Postgres 需要 `@prisma/adapter-pg`：
//
//        import { PrismaPg } from '@prisma/adapter-pg'
//        const adapter = new PrismaPg({ connectionString: process.env.DATABASE_URL })
//        export const prisma = new PrismaClient({ adapter })
//
//    （本轮**没有**装它 —— 本机还没有 PG 实例，装了也用不上；等接 PrismaService 时一起加。）
//
// 2. **`.env` 不再自动加载**：CLI 侧要在 `prisma.config.ts` 里显式 `import 'dotenv/config'`。

/// 用户。
///
/// 用户名或邮箱是登录账号；cuid 主键不随昵称修改，角色权限通过关联表恢复。
///
/// ⚠️ 主键类型的取舍：**面向人的实体**（User）保留 cuid —— 它出现在 URL 与外部引用里，
/// 不可枚举、不泄露数量；**纯内部字典/关联实体**（Role / Permission / Resume / ResumeDraft）
/// 用 integer 自增，便于人工查找与维护。
///
/// ⚠️ 两个刻意的设计：
/// - **只存 `passwordHash`，不存明文**（也不存"可解密"的形式）：哈希是单向 + 随机盐 + 故意慢，
///   盐防彩虹表、慢让暴力破解不划算；
/// - **权限不在这张表上**：走 `user_roles → role_permissions → permissions`。
///   表结构多两张，换来"人可以有多个角色、角色可以改权限"这两件事不用改表。
model User {
  id           String    @id @default(cuid())
  /// 可选的唯一登录名；实际格式由 DTO 校验，数据库同时保留唯一约束。
  username     String?   @unique
  /// 可修改的展示昵称；为空时展示层回退到 username 或 email。
  nickname     String?
  /// 可选的唯一登录邮箱，创建与登录时统一去首尾空格、转小写。
  email        String?   @unique
  /// 旧手机号暂保留数据；当前接口不接收也不返回。
  phone        String?   @unique
  avatar       String?
  /// 密码哈希（scrypt，格式见 `src/common/password.ts`）
  passwordHash String
  /// 会话版本；递增后，旧版本 JWT 立即失效。
  sessionVersion Int @default(0) @map("session_version")
  /// 软删除标记（有值即视为已删除）。
  /// 登录、会话恢复和后续用户查询需显式排除已删除记录。
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles UserRole[]
  resumeWorkspace ResumeWorkspace?
  editedResumeDrafts ResumeDraft[]
  shareLinks       ShareLink[]     @relation("ShareLinkCreator")

  @@map("users")
}

/// 角色。role.key 必须与 `src/auth/permission-keys.ts` 的 `ROLE_PERMISSION_PRESETS` 对齐（seed 校验）。
model Role {
  id          Int      @id @default(autoincrement())
  /// 稳定的机器可读标识：`super_admin` / `admin` / `user`
  key         String   @unique
  /// 展示名：`管理员` / `普通用户`
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// 权限键。**键名定义在代码里**（`src/auth/permission-keys.ts`），这里只承载"关系"。
/// seed 会按代码常量同步这张表（幂等）。
model Permission {
  id          Int      @id @default(autoincrement())
  /// `<域>.<资源>:<动作>`，例如 `Resume.Profile:view`
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

/// 角色 ↔ 权限（多对多）
model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// 用户 ↔ 角色（多对多）。
/// 多对多而不是 `User.roleId`：当前有三种预设角色，后续可同时关联编辑与审核等角色，
/// 那时改表 + 改所有查询，比一开始就留一张关联表贵得多。多角色时权限**取并集去重**。
model UserRole {
  userId String
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model ResumeWorkspace {
  /// 本人的跨简历公共纸面预设；复制应用，不联动已保存简历。
  pdfConfig Json? @db.JsonB @map("pdf_config")
  userId String @id @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  resumes Resume[]

  @@map("resume_workspaces")
}

/// 简历主体。
///
/// **删除是物理删除**（没有 `deletedAt`）：简历正文是用户自己生成的内容，删掉就是不要了 ——
/// 留着软删标记只会让库里持续积累看不见的简历与草稿，形成污染。
/// 需要留痕的是**账号**（`User` 仍有 `deletedAt`：审计、恢复、责任边界），不是简历。
///
/// ⚠️ 删一份简历会**级联删掉它的草稿**（见 `ResumeDraft.resume`），所以删除入口必须保留二次确认。
model Resume {
  id Int @id @default(autoincrement())
  workspaceUserId String @map("workspace_user_id")
  name String @db.VarChar(80)
  locale String @db.VarChar(20)
  /// 「默认展示」的简历：访客/首页看的就是它。**每个用户至多一份** —— 互斥由服务端在同一事务里保证
  /// （没有加 partial unique index：Prisma schema 表达不了，硬加会让 `migrate dev` 每次都报漂移）
  isDefault Boolean @default(false) @map("is_default")
  /// 发布态：**null 表示未发布** —— 公开读（`/resume/public` 与 `/resume/public/:id`）只认已发布的。
  /// 用可空时间戳而不是布尔：一个字段同时表达「是否发布」与「何时发布」，
  /// 且判据只有一条（IS NULL / IS NOT NULL），不会随「某些历史数据是例外」而漂移。
  publishedAt DateTime? @map("published_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  workspace ResumeWorkspace @relation(fields: [workspaceUserId], references: [userId], onDelete: Restrict)
  draft ResumeDraft?
  shareLinks ShareLink[]

  @@index([workspaceUserId])
  @@map("resumes")
}

model ResumeDraft {
  id Int @id @default(autoincrement())
  resumeId Int @unique @map("resume_id")
  schemaVersion Int @map("schema_version")
  document Json @db.JsonB
  revision Int @default(1)
  updatedBy String @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  editor User @relation(fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("resume_drafts")
}

/// 关键操作的审计记录（**只增不改**）。设计说明见 docs/server/10_审计表_设计与落地.md。
///
/// ## 与业务表的关系是「值引用 + 快照」，**不是外键**
///
/// 简历是**物理删除**（见 `Resume` 注释）、账号可软删。若挂 `onDelete: Cascade`，
/// "删除资源"会连带删掉追责记录 —— 与"审计一直保留"正面冲突；
/// 若挂 `SetNull` 则会丢掉"是哪个资源"。所以这里**不放任何外键约束**：
/// 用 `resourceType` + `resourceId` 按值指认，再用快照保证资源消失后依然可读。
///
/// ## 为什么快照字段必须在第一版就有
///
/// `actorRoleKeys` / `actorSnapshot` 这类字段**补不回来**：此刻不记，
/// 那个时点的角色与昵称就永久消失，后补的行只会永远显示"当时未知"。
///
/// ## 不记录简历内容与 PII
///
/// `metadata` 走白名单（见 `common/audit.ts`）；严禁写入简历 document、姓名、手机号、邮箱。
model AuditLog {
  id String @id @default(cuid())

  /// 操作者 id。**不挂外键** —— 账号可能已被删除，记录必须留下
  actorId String @map("actor_id")
  /// 操作当时的昵称/邮箱快照：只有 actorId 的话，账号删掉后没人看得懂这条记录
  actorSnapshot Json? @map("actor_snapshot")
  /// 操作当时的角色键快照（追责时回答"他当时是什么身份"）
  actorRoleKeys String[] @map("actor_role_keys")

  /// 动作标识（如 resume.delete）。用 String 而非 Prisma enum：
  /// 新增动作不需要迁移，符合"边做边完善"；代价是失去数据库层枚举约束，由应用常量与测试兜住
  action String @db.VarChar(64)

  resourceType String @db.VarChar(32) @map("resource_type")
  /// **String 而非 Int**：Resume.id 是 Int、User.id 是 cuid，统一成字符串才装得下两类资源
  resourceId String @map("resource_id")
  /// 资源快照（如简历标题）：让人能读懂"删的是哪一份"
  resourceSnapshot Json? @map("resource_snapshot")

  occurredAt DateTime @default(now()) @map("occurred_at")
  /// 与请求日志关联（复用 TraceIdMiddleware 的 id），可追到当时的完整上下文
  requestId String? @map("request_id")
  /// 动作特有的少量信息（白名单）。一个请求可产生多条审计 → **不加唯一约束**
  metadata Json?

  /// "这份简历的历史" —— 追责最常见的入口
  @@index([resourceType, resourceId, occurredAt])
  /// "这个人做过什么"
  @@index([actorId, occurredAt])
  /// 归档遍历 / 按时间范围审计
  @@index([occurredAt])
  @@map("audit_logs")
}

/// 上传文件记录。
///
/// ## 为什么必须有这张表
///
/// 不建表就只能靠文件名猜归属：**孤儿文件无法可靠清理**（谁传的、什么时候传的都不知道），
/// 也无法按用户做配额或鉴权。路径与 `purpose` 都冗余存一份 ——
/// 文件系统结构给人看，DB 字段给查询用，一致性由写入路径保证（参 `DAO-036`）。
model UploadedFile {
  id Int @id @default(autoincrement())
  /// 上传者（`User.id`）；不挂外键：与审计同理，账号清理后记录仍要能读懂
  ownerId String @map("owner_id")
  /// 用途：avatar / resume-import / resume-asset（决定磁盘一级目录）
  purpose String @db.VarChar(40)
  /// 相对 `static/upload` 的路径（不含前缀，便于将来换对象存储）
  path String @db.VarChar(255)
  originalName String @map("original_name") @db.VarChar(255)
  mime String @db.VarChar(100)
  size Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId])
  @@index([purpose, createdAt])
  @@map("uploaded_files")
}

/// 分享链接：**链接级授权**（有效期 / 可撤销 / 权限位）。
///
/// 与作者级的 `Resume.publishedAt` 是**两层**，不是替代关系：
/// - `publishedAt` 回答"这份简历对外公开了吗"
/// - 本表回答"**这一条链接**还能不能被读、能读到什么"
///
/// 两条都要过：链接授权不能绕过"未发布不可读"。
model ShareLink {
  id        String @id @default(cuid())
  /// URL 里那段（`/s/:token`）：随机、不可猜。**不用自增 id** —— 那正好补上公开读的枚举问题
  token     String @unique @db.VarChar(64)
  resumeId  Int    @map("resume_id")
  createdBy String @map("created_by")

  /// 到期时间（UTC）。服务端强制：创建时最多 `now + 90 天`
  expiresAt DateTime  @map("expires_at")
  /// 物化撤销：主动撤销、或简历取消发布时写入。**一旦写入即永久失效**，重新发布也不会复活
  revokedAt DateTime? @map("revoked_at")

  /// 预留的 AI 能力位：本轮**只存不用**，等 AI 上线再校验
  allowAi  Boolean @default(false) @map("allow_ai")
  /// 是否允许通过该链接下载 PDF（访客没有登录态，所以需要这条授权）
  allowPdf Boolean @default(true) @map("allow_pdf")

  createdAt    DateTime  @default(now()) @map("created_at")
  lastAccessAt DateTime? @map("last_access_at")

  resume  Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  creator User   @relation("ShareLinkCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([resumeId])
  @@index([expiresAt])
  @@map("share_links")
}
