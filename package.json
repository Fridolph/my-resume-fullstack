{
  "name": "my-resume-fullstack",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Turbo + pnpm full-stack template",
  "scripts": {
    "dev": "pnpm --filter @rs/common build && turbo run dev",
    "build": "turbo run build",
    "build:fresh": "turbo run build --force",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "clean": "rm -rf .turbo apps/*/.nuxt apps/*/.output apps/server/dist packages/*/dist",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "changelog": "release-it --dry-run --no-git.commit --no-git.tag --no-git.push --no-npm.publish --no-github.release",
    "release:dry": "release-it --dry-run --no-git.push --no-npm.publish --no-github.release",
    "release-notes:check": "node scripts/sync-release-notes.mjs --check",
    "check": "pnpm release-notes:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "release-it": "^21.1.1",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
