# ── apps/api ─────────────────────────────────────────
# 端口（默认 4049）
PORT=4049

# 运行环境：development | test | production
NODE_ENV=development

# 日志最小级别：trace | debug | info | warn | error | fatal | silent（默认 info）
# 本地想看得更细就设 debug；生产保持 info，避免把噪声写进采集器
LOG_LEVEL=info

# JWT 签名密钥 —— 必须自行生成，且不要提交真实值。
# 生成方式：node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))"
JWT_SECRET=

# 访问令牌有效期（ms 风格字符串，如 2h / 7d）
JWT_EXPIRES_IN=2h

# PostgreSQL 连接串 —— 本地用仓库根的 compose.yaml 起库（docker compose up -d）
DATABASE_URL="postgresql://resume:resume_dev_password@localhost:5432/my_resume?schema=public"

# CORS 白名单：允许跨域调用本接口的站点来源，逗号分隔（每项含协议与端口，不含路径）
# development 不配则默认 http://localhost:4041,http://localhost:4047（web / admin）
# ⚠️ production 必须显式配置，缺失会直接启动失败；不允许写 *（等于全放行）
CORS_ORIGINS="http://localhost:4041,http://localhost:4047"

# 登录限流（B3）：每个 IP 在窗口内允许的登录尝试次数，与窗口长度（**毫秒**，throttler v5 起）
# 超限返回 429 + errorCode AUTH.Login:throttled。只作用于登录接口，不影响其他路由
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_MS=60000
